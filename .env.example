# Copy to apps/api/.env and fill in. Never commit real secrets.
DATABASE_URL=postgresql://loadwise:loadwise@localhost:5432/loadwise?schema=public
PORT=3000
# Firebase project ID (Project settings > General). Not a secret, and no service account key is
# needed. Left empty, the API rejects every sign-in.
FIREBASE_PROJECT_ID=
# Browser origins allowed to call the API, comma-separated. Empty allows none.
# http://localhost:8081 is the Expo web app started with pnpm dev.
CORS_ORIGINS=http://localhost:8081
